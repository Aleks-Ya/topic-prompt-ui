<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.web.WebView?>
<HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="topicpromptui.ui.view.AnswerController">
    <!-- prefWidth on the VBox, not on the ComboBox: every pixel here is taken from the answer WebView,
         and a fixed column keeps all four WebViews starting at the same x whatever the display name. -->
    <VBox alignment="TOP_CENTER" prefWidth="100.0">
        <ComboBox fx:id="providerComboBox" maxWidth="1.7976931348623157E308" onAction="#onProviderSelected"/>
        <Separator visible="false"/>
        <Button fx:id="answerButton" mnemonicParsing="false" onAction="#onAnswerButtonClick" text="ⓘ">
            <tooltip>
                <Tooltip text="Answer info"/>
            </tooltip>
        </Button>
    </VBox>
    <Separator orientation="VERTICAL" prefHeight="200.0" visible="false"/>
    <WebView fx:id="webView" prefHeight="218.0" prefWidth="477.0" HBox.hgrow="ALWAYS"/>
    <Separator orientation="VERTICAL" prefHeight="200.0" visible="false"/>
    <VBox alignment="TOP_CENTER" prefWidth="80.0">
        <Button fx:id="copyButton" onAction="#clickCopyButton" text="Copy"/>
        <Separator visible="false"/>
        <HBox alignment="CENTER" prefHeight="30.0" prefWidth="200.0" VBox.vgrow="NEVER">
            <Circle fx:id="statusCircle" fill="WHITE" radius="12.0" stroke="BLACK" strokeType="INSIDE"/>
            <Separator orientation="VERTICAL" prefHeight="200.0" visible="false"/>
            <!--suppress JavaFxUnresolvedFxIdReference -->
            <Button fx:id="regenerateButton" mnemonicParsing="false" onAction="#onRegenerateButtonClick" text="⟳"/>
        </HBox>
        <Separator visible="false"/>
        <Button fx:id="expandButton" mnemonicParsing="false" onAction="#onExpandButtonClick" text="⛶">
            <tooltip>
                <Tooltip text="Expand / collapse (Esc)"/>
            </tooltip>
        </Button>
    </VBox>
</HBox>
