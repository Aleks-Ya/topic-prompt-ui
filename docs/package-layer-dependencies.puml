@startuml
'https://plantuml.com/class-diagram

package topicpromptui {
    package core {
        package ai {}
        package util #orange {}
        package domain #green {}
        package storagefilesystem {}
    }
    package ui {
        package model {}
        package view {}
        package viewmodel {}
    }
}

' Arrows into domain are green, arrows into util are orange, to make the
' two widely-shared leaf packages easy to trace across the layers.
view --> viewmodel
view -[#green]-> domain
view -[#orange]-> util
viewmodel --> model
viewmodel -[#green]-> domain
viewmodel -[#orange]-> util
model --> ai
model --> storagefilesystem
model -[#green]-> domain
model -[#orange]-> util
storagefilesystem -[#green]-> domain
storagefilesystem -[#orange]-> util
domain -[#orange]-> util

@enduml
