@startuml
hide empty members
left to right direction

title QuestionModel interface

interface QuestionModel {
    requestAnswer()
    requestFollowUpAnswer()
}
interface StorageModel {
    readInteraction()
    getTopic()
    updateInteraction()
}
interface PromptFactory {
    getPrompt()
}
interface AiApi {
    send()
}
interface AiProviderSelectionModel {
    getProvider()
}
interface SoundService {
    beenOnAnswer()
}
interface FormatConverter {
    markdownToHtml()
}
interface GrammarDiffMarker {
    markChanges()
}
interface FollowUpHistoryBuilder {
    buildHistory()
}

QuestionModel --> StorageModel
QuestionModel --> PromptFactory
QuestionModel --> AiProviderSelectionModel: which provider backs the pane
QuestionModel "1" --> "*" AiApi: Map<AiProvider, AiApi>,\nlooked up by the selected provider
QuestionModel --> SoundService
QuestionModel --> FormatConverter
QuestionModel --> GrammarDiffMarker: GRAMMAR only
QuestionModel --> FollowUpHistoryBuilder

FollowUpHistoryBuilder --> StorageModel

@enduml
